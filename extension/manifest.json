{
  "manifest_version": 3,
  "name": "よみりん",
  "version": "0.31.0",
  "description": "Google Play ブックスの読書に、だんだん外れていく補助輪。",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": [
    "https://play.google.com/books/*",
    "https://books.googleusercontent.com/books/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/dashboard/dashboard.html",
  "action": {
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
    "default_title": "読む",
    "default_popup": "src/popup/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/*.js", "src/shared/*.js", "assets/bear/*", "assets/story/*"],
      "matches": ["https://play.google.com/*", "https://books.googleusercontent.com/*"]
    }
  ]
}
